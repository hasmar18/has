# Zkopírujte do .env pro lokální vývoj. NIKDY necommitujte skutečné hodnoty.
DATABASE_URL=postgres://hasnails:hasnails@localhost:5432/hasnails
DATABASE_SSL=0                      # na Renderu (interní URL) není potřeba; pro externí připojení 1
PORT=3000
BASE_URL=http://localhost:3000      # na produkci veřejná https adresa bez lomítka
NODE_ENV=development
ENCRYPTION_KEY=                     # 32 bajtů v base64/hex: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_EMAIL=                        # první administrátor (vytvoří se jen pokud ještě neexistuje)
ADMIN_INITIAL_PASSWORD=             # min. 10 znaků; po prvním přihlášení se musí změnit a proměnná se odstraní
BREVO_API_KEY=
MAIL_FROM_EMAIL=                    # ověřený odesílatel/doména v Brevo
MAIL_FROM_NAME=HASNAILS
MAIL_REPLY_TO=
BREVO_WEBHOOK_SECRET=               # náhodný řetězec; webhook: {BASE_URL}/api/webhooks/brevo?secret=…
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
RUN_WORKER=1                        # úlohy na pozadí (e-maily, upomínky, kalendář) běží uvnitř webové služby
